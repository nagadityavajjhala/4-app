{
  "rules": {
    // Only authenticated users can read/write
    ".read": "auth != null",
    ".write": "auth != null",
    // Typing indicators per conversation
    "typing": {
      "$conversationId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth.uid === $uid"
        }
      }
    },
    // Call signaling — both caller and callee need read access
    "callSignals": {
      "$calleeId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$conversationId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    // Presence
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    }
  }
}
